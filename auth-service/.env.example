# Profile do Compose. Sem isso, `docker compose up` sobe so o banco.
COMPOSE_PROFILES=apps

# Banco proprio deste servico
POSTGRES_DB=auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5435

# Aplicacao
SERVER_PORT=8083

# HTTPS interno com mTLS para consultas entre servicos
MTLS_ENABLED=true
MTLS_SERVER_PORT=9443
MTLS_KEYSTORE=file:../.mtls/auth-server.p12
MTLS_KEYSTORE_PASSWORD=changeit
MTLS_TRUSTSTORE=file:../.mtls/ca-truststore.p12
MTLS_TRUSTSTORE_PASSWORD=changeit
MTLS_CLIENT_COMMON_NAME=appointment-service
